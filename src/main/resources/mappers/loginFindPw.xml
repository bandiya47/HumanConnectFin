<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="dc.human.gbnb.humanConnect.login.dao.LoginFindPwDAO">

    <!--    <resultMap id="findPwResult" type="dc.human.gbnb.humanConnect.login.vo.UserVO">-->
    <!--        <result property="userId" column="id" />-->
    <!--    </resultMap>-->

    <select id="selectFindPw" parameterType="map">
        <![CDATA[
        SELECT u_id as Result
          FROM volunteer_user
         WHERE u_id = #{userId} AND u_name = #{userName} AND u_email = #{userEmail}
        ]]>
    </select>

    <update id="updateFindPw" parameterType="map">
        <![CDATA[
        UPDATE volunteer_user
           SET u_pwd = #{userPw},
               updated_id = #{userId},
               updated_date = SYSDATE
         WHERE u_id = #{userId}
        ]]>
    </update>
</mapper>