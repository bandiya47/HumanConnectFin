    <select id="getMyVolunteerList" resultType="dc.human.gbnb.humanConnect.volunteer.vo.MainVO"
            parameterType="String">
        SELECT
            v.U_ID,
            v.V_NO,
            r.V_TITLE,
            v.VREG_START_DATE,
            v.VREG_END_DATE,
            s.service_type,
            c.C_NAME,
            c.C_PHONE
        FROM volunteer_reg v
        INNER JOIN CENTER_MNG_TABLE c
        ON c.C_ID = V.C_ID
        INNER JOIN volunteer r
        ON r.V_NO = V.V_NO
        INNER JOIN service_type_table s
        ON s.service_code = r.service_code
        WHERE
            u_id=#{u_id}
    </select>


