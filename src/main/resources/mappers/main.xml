<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="dc.human.gbnb.humanConnect.volunteer.dao.MainDAO">

    <resultMap id="MainVOResultMap" type="dc.human.gbnb.humanConnect.volunteer.vo.MainVO">
        <result property="u_id" column="U_ID"/>
        <result property="v_no" column="V_NO"/>
        <result property="v_title" column="V_TITLE"/>
        <result property="vreg_start_date" column="VREG_START_DATE"/>
        <result property="vreg_end_date" column="VREG_END_DATE"/>
        <result property="service_type" column="SERVICE_TYPE"/>
        <result property="c_name" column="C_NAME"/>
        <result property="c_phone" column="C_PHONE"/>
    </resultMap>

    <select id="getMyVolunteerList" resultMap="MainVOResultMap"
            parameterType="String">
        SELECT
        v.U_ID,
        v.V_NO,
        r.V_TITLE,
        v.VREG_START_DATE,
        v.VREG_END_DATE,
        s.service_type,
        c.C_NAME,
        c.C_PHONE
        FROM volunteer_reg v
        INNER JOIN CENTER_MNG_TABLE c
        ON c.C_ID = v.C_ID
        INNER JOIN volunteer r
        ON r.V_NO = v.V_NO
        INNER JOIN service_type_table s
        ON s.service_code = r.service_code
        WHERE
        v.u_id=#{u_id}
    </select>

</mapper>
