<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="dc.human.gbnb.humanConnect.login.dao.FindIdDAO">
    <select id="searchMember" parameterType="dc.human.gbnb.humanConnect.login.vo.FindIdVO" resultType="java.lang.String">
        SELECT
            U_ID
        FROM
            volunteer_user
        WHERE
            U_NAME = #{u_Name} AND U_EMAIL = #{u_Email}
    </select>
</mapper>
